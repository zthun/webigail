{
  "name": "@zthun/webigail",
  "description": "Http service with url handling.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/webigail"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log'",
    "check": "tsc --noEmit",
    "test": "vitest --run --coverage",
    "lint": "janitor-lint",
    "build": "lerna run build",
    "make": "yarn clean && yarn check && yarn lint && yarn test && yarn build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.1.0",
    "@types/url-parse": "^1.4.11",
    "@vitest/coverage-v8": "^4.0.18",
    "@zthun/janitor-build-config": "^19.5.6",
    "@zthun/janitor-lint": "^19.5.6",
    "@zthun/janitor-lint-config": "^19.5.6",
    "@zthun/janitor-options": "^19.5.6",
    "@zthun/janitor-ts-config": "^19.5.3",
    "happy-dom": "^20.4.0",
    "husky": "^9.1.7",
    "lerna": "9.0.3",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@4.12.0"
}
